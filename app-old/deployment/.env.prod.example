# ==============================================================================
# UNIFIED PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.prod before starting the docker-compose stack.
# Replace all "your_ip_or_domain" with your Oracle VM Public IP initially.
# ==============================================================================

# ==============================================
# 1. DOMAINS & SSL
# ==============================================

# Your main API domain or IP (e.g. 123.45.67.89 or api.yourdomain.com)
API_DOMAIN=your_ip_or_domain

# Your WA-AKG domain or IP (e.g. 123.45.67.89 or wa.yourdomain.com)
WA_AKG_DOMAIN=your_ip_or_domain

# Email address for Let's Encrypt SSL certificates (needed for later)
ACME_EMAIL=admin@yourdomain.com

# ==============================================
# 2. DIAL MATE CORE & DB CONFIGURATION
# ==============================================

# Dial Mate Database Credentials
POSTGRES_USER=dialmate
POSTGRES_PASSWORD=generate_a_secure_password
POSTGRES_DB=dialmate

# Connection strings for Prisma/BullMQ
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379

# JWT Secret (Required for authentication and session signing, > 16 chars)
JWT_SECRET=generate_a_secure_random_string_here

# Application URL (Use HTTP with IP for now)
APP_URL=http://${API_DOMAIN}
FRONTEND_URL=http://${API_DOMAIN}

# Server Listening Port (Internal to docker network)
PORT=8787

# ==============================================
# 3. WA-AKG DB CONFIGURATION
# ==============================================

# WA-AKG Database Credentials (MySQL)
WA_MYSQL_PASSWORD=generate_another_secure_password
WA_MYSQL_DB=wa_akg

# NextAuth Encryption Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=generate_a_secure_random_string_here_for_wa_akg

# Public facing Next.js URLs
NEXTAUTH_URL=http://${WA_AKG_DOMAIN}:3000
NEXT_PUBLIC_APP_URL=http://${WA_AKG_DOMAIN}:3000
NEXT_PUBLIC_API_URL=http://${WA_AKG_DOMAIN}:3000/api
BASE_URL=http://${WA_AKG_DOMAIN}:3000
AUTH_TRUST_HOST=true
NODE_ENV=production

# ==============================================
# 4. EXTERNAL INTEGRATIONS
# ==============================================

# -- SHOPIFY --
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# -- WA-AKG INTEGRATION (DIAL MATE -> WA-AKG) --
WA_AKG_BASE_URL=http://wa-akg:3000
WA_AKG_API_KEY=your_wa_akg_api_key_here
WA_AKG_SESSION_ID=your_wa_akg_session_id_here
WA_AKG_WEBHOOK_SECRET=your_wa_akg_webhook_secret_here

# -- TWILIO --
# Note: Twilio requires HTTPS for webhooks. It is blocked until you set up a domain and Let's Encrypt!
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# -- GEMINI AI --
GEMINI_API_KEY=your_gemini_api_key_here
