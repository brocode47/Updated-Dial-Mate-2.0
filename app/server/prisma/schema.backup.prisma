generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     Shop[]
  users     User[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  passwordHash   String?
  role           String       @default("OWNER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Shop {
  id                   String                @id @default(uuid())
  organizationId       String
  domain               String                @unique
  accessToken          String?
  isActive             Boolean               @default(true)
  installedAt          DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  calls                Call[]
  conversations        Conversation[]
  customers            Customer[]
  orders               Order[]
  organization         Organization          @relation(fields: [organizationId], references: [id])
  webhooks             WebhookEvent[]
  whatsAppIntegrations WhatsAppIntegration[]
  products             Product[]
}

model Customer {
  id            String         @id @default(uuid())
  shopId        String
  shopifyId     String?
  phone         String?
  email         String?
  firstName     String?
  lastName      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  shop          Shop           @relation(fields: [shopId], references: [id])
  orders        Order[]
}

model Order {
  id              String    @id @default(uuid())
  shopId          String
  customerId      String?
  shopifyOrderGid String?
  orderNumber     String?
  payload         String?
  status          String    @default("Pending Confirmation")
  tag             String?
  riskScore       Float?    @default(0.0)
  retryCount      Int       @default(0)
  callStatus      String    @default("pending")
  callSid         String?
  lastCallAt      DateTime?
  totalAmount     Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  calls           Call[]
  customer        Customer? @relation(fields: [customerId], references: [id])
  shop            Shop      @relation(fields: [shopId], references: [id])
}

model Call {
  id              String   @id @default(uuid())
  shopId          String
  orderId         String?
  outcome         String?
  intent          String?
  sentiment       String?
  durationSec     Int?
  recordingUrl    String?
  transcript      String?
  providerCallSid String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order?   @relation(fields: [orderId], references: [id])
  shop            Shop     @relation(fields: [shopId], references: [id])
}

model Conversation {
  id         String    @id @default(uuid())
  shopId     String
  customerId String?
  channel    String    @default("WHATSAPP")
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])
  shop       Shop      @relation(fields: [shopId], references: [id])
  messages   Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  sender         String
  text           String?
  mediaUrl       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  shopId    String
  topic     String
  payload   String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id])
}

model ComplianceLog {
  id         String   @id @default(uuid())
  shopDomain String?
  event      String
  detail     String?
  createdAt  DateTime @default(now())
}

model WhatsAppIntegration {
  id        String   @id @default(uuid())
  shopId    String
  provider  String
  sessionId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id])

  @@unique([provider, sessionId])
  @@index([shopId])
  @@index([isActive])
}
model Product {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  description String?
  category    String?
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([category])
}
