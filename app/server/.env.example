# ==============================================================================
# DIAL MATE SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application.
# All required variables must be configured for a production deployment.
# ==============================================================================

# ==============================================
# 1. CORE & INFRASTRUCTURE
# ==============================================

# Server Listening Port (Default: 8787)
PORT=8787

# Application URL (Public HTTPS domain where this server is accessible)
APP_URL=https://api.yourdomain.com

# Frontend URL for CORS and Authentication Redirects
FRONTEND_URL=https://app.yourdomain.com

# PostgreSQL Connection String (Required for Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/dialmate

# Redis Connection String (Required for BullMQ and ChatState)
REDIS_URL=redis://localhost:6379

# JWT Secret (Required for authentication and session signing, > 16 chars)
JWT_SECRET=generate_a_secure_random_string_here


# ==============================================
# 2. SHOPIFY INTEGRATION
# ==============================================

# Shopify App Credentials (from Partners Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# (Optional) Shopify Webhook Secret, defaults to SHOPIFY_API_SECRET
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# (Optional) Shopify API Version (Default: 2024-01)
SHOPIFY_API_VERSION=2024-01

# (Optional) Shopify Scopes (Default: read_orders,write_orders)
SHOPIFY_SCOPES=read_orders,write_orders


# ==============================================
# 3. WA-AKG (WHATSAPP) INTEGRATION
# ==============================================

# The internal/external URL where the WA-AKG service is reachable
WA_AKG_BASE_URL=http://localhost:3000

# The API Key for WA-AKG (to authorize outgoing messages)
WA_AKG_API_KEY=your_wa_akg_api_key_here

# The exact Session ID in WA-AKG that Dial Mate will use for outgoing WhatsApp replies
WA_AKG_SESSION_ID=your_wa_akg_session_id_here

# Webhook Secret used to verify incoming requests from WA-AKG
WA_AKG_WEBHOOK_SECRET=your_wa_akg_webhook_secret_here


# ==============================================
# 4. TWILIO INTEGRATION
# ==============================================

# Twilio Credentials (Required for AI Voice Calls & Media Streams)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The verified Twilio phone number used for outgoing calls
TWILIO_FROM_NUMBER=+1234567890


# ==============================================
# 5. GEMINI AI
# ==============================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here


# ==============================================
# 6. FEATURE FLAGS (Optional)
# ==============================================
APP_MODE=single_store
FEATURE_PUBLIC_SAAS=false
FEATURE_BILLING=false
FEATURE_MULTI_TENANT=false
FEATURE_TEAM_MEMBERS=false
FEATURE_WHITE_LABEL=false
FEATURE_SHOPIFY_PUBLIC_INSTALL=false
FEATURE_USAGE_BILLING=false
FEATURE_MARKETPLACE=false
